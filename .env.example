# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS: used by sync and grading jobs. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as a bearer token so sync routes cannot be
# triggered by anyone who finds the URL.
CRON_SECRET=

# Web push (VAPID). Generate a pair with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# The public key ships to the browser; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
